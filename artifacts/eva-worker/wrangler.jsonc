{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ah-lb03",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../eva-fabrics-store/dist/public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sport-store",
      "database_id": "PLACEHOLDER_WILL_CREATE"
    }
  ],
  "vars": {
    "STORE_ORIGIN": "https://sport.workers.dev"
  }
}
